{
  "name": "inboxplease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,web \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --strict-vars false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:seed": "wrangler d1 execute DB --local --config wrangler.local.jsonc --file scripts/seed.sql",
    "setup:local": "node scripts/setup-local.mjs && npm run db:migrate && npm run db:seed",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dry-run": "wrangler deploy --dry-run --outdir dist/worker --config wrangler.jsonc",
    "dry-run:staging": "wrangler deploy --dry-run --outdir dist/worker-staging --config wrangler.staging.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "eval:images": "tsx scripts/evaluate-images.ts",
    "eval:live": "tsx scripts/evaluate-live.ts",
    "test:browser": "playwright test",
    "build:production": "VITE_API_ORIGIN=https://api.inboxplease.helloimabid.com vite build",
    "deploy:production": "npm run build:production && wrangler deploy --config wrangler.production.jsonc",
    "predeploy:production": "npm run typecheck"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "drizzle-orm": "^0.45.2",
    "fast-png": "^8.0.0",
    "hono": "^4.13.7",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
